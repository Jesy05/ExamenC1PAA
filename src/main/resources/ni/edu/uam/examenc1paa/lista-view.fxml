<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.examenc1paa.ListaSolicitudesController">
    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <Label text="Consulta de Solicitudes" />
            <TextField fx:id="txtBuscar" promptText="Buscar por cliente o numero" />
        </VBox>
    </top>
    <center>
        <TableView fx:id="tablaSolicitudes" prefHeight="300.0">
            <columns>
                <TableColumn fx:id="colNumero" prefWidth="90.0" text="Numero" />
                <TableColumn fx:id="colCliente" prefWidth="150.0" text="Cliente" />
                <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha" />
                <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
                <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="15.0" />
            </padding>
            <Button fx:id="btnActualizar" mnemonicParsing="false" text="Cambiar Estado" onAction="#cambiarEstado" />
            <Button mnemonicParsing="false" text="Eliminar" onAction="#eliminarSolicitud" />
            <Button mnemonicParsing="false" text="Volver" onAction="#volver" />
        </HBox>
    </bottom>
</BorderPane>