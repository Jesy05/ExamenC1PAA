<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.examenc1paa.DetalleSolicitudController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>
    <Label text="Detalle de Solicitud" />
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="140.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="Infinity" minWidth="10.0" prefWidth="300.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
        <Label text="Numero:" GridPane.rowIndex="0" />
        <Label fx:id="lblNumero" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Cliente:" GridPane.rowIndex="1" />
        <Label fx:id="lblCliente" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Fecha:" GridPane.rowIndex="2" />
        <Label fx:id="lblFecha" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="Tipo:" GridPane.rowIndex="3" />
        <Label fx:id="lblTipo" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Label text="Descripcion:" GridPane.rowIndex="4" />
        <Label fx:id="lblDescripcion" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <Label text="Estado:" GridPane.rowIndex="5" />
        <ComboBox fx:id="cbEstado" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
    </GridPane>
    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="btnGuardar" mnemonicParsing="false" text="Guardar Estado" onAction="#guardarEstado" />
        <Button mnemonicParsing="false" text="Volver" onAction="#volver" />
    </HBox>
</VBox>